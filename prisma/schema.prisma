
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Technician {
  id       String    @id @default(cuid())
  name     String
  country  String
  city     String
  active   Boolean   @default(true)
  slots    Slot[]
  bookings Booking[]
}

model Slot {
  id           String   @id @default(cuid())
  technicianId String
  startAt      DateTime
  endAt        DateTime
  isBlocked    Boolean  @default(false)

  technician Technician @relation(fields: [technicianId], references: [id])
  booking    Booking?

  @@unique([technicianId, startAt])
}

model Booking {
  id              String   @id @default(cuid())
  customerName    String
  email           String
  phone           String
  address         String
  postal          String
  city            String
  country         String
  tvSize          String
  mountType       String
  wallType        String
  notes           String?
  priceCents      Int
  depositCents    Int      @default(0)
  currency        String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  slotId          String   @unique
  technicianId    String
  stripeSessionId String?  @unique
  accessToken     String   @unique

  slot       Slot       @relation(fields: [slotId], references: [id])
  technician Technician @relation(fields: [technicianId], references: [id])
}
  
